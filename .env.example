# NETSCOPE — Configuration & Environment Variables

# Backend Port and Host
NETSCOPE_HOST=127.0.0.1
NETSCOPE_PORT=8000

# SQLite Database Location
NETSCOPE_DB_PATH=netscope.db

# Scanning Constraints
NETSCOPE_TIMEOUT=8.0
NETSCOPE_MAX_DEPS=50
NETSCOPE_IPV6_PROBE=2001:4860:4860::8888

# Optional: Google Gemini API Key for AI-assisted NETSCOPE INSIGHT explanations
# If not provided, NETSCOPE automatically falls back to deterministic expert diagnostics
GEMINI_API_KEY=
